#
# Phicomm K2P-32M 种子配置（32MB SPI NOR 闪存版）
# 底座：padavanonly/immortalwrt @ master（ramips/mt7621，immortalwrt 18.06 基线）
# 说明：
#   * K2P 设备默认 DEVICE_PACKAGES 已是 kmod-mt7615d luci-app-mtwifi（闭源 MTK mt_wifi），无需 wireless patch
#   * 32MB 闪存由 scripts/25-add-k2p-32m.sh 修改 mt7621.mk + DTS 实现（IMAGE_SIZE 16064k->32128k、firmware 分区 0xfb0000->0x1fb0000）
#   * 本 seed 不勾 luci-ssl，纯 HTTP LuCI（与 msg1500 一致，避免 libustream 后端冲突）
#

# ---------- 目标设备 ----------
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_DEVICE_ramips_mt7621_DEVICE_phicomm_k2p=y
# 旧式符号兜底（defconfig 会保留有效的一个）
CONFIG_TARGET_ramips_mt7621_DEVICE_phicomm_k2p=y

# ---------- 构建选项 ----------
CONFIG_DEVEL=y
CONFIG_CCACHE=y

# ---------- LuCI 基础（纯 HTTP，无 ssl）----------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# ---------- 闭源 MT7615 驱动（K2P 设备默认即 kmod-mt7615d + luci-app-mtwifi，显式 pin 双保险）----------
CONFIG_PACKAGE_kmod-mt7615d=y
CONFIG_PACKAGE_luci-app-mtwifi=y
CONFIG_PACKAGE_mt_wifi=y

# ---------- 内网穿透 ----------
CONFIG_PACKAGE_luci-app-ngrokc=y
CONFIG_PACKAGE_ngrokc=y
CONFIG_PACKAGE_luci-i18n-ngrokc-zh-cn=y
CONFIG_PACKAGE_luci-app-frpc=y
CONFIG_PACKAGE_frpc=y
CONFIG_PACKAGE_luci-i18n-frpc-zh-cn=y
CONFIG_PACKAGE_luci-app-autoreboot=y

# ---------- xray-core + ssr-plus（VLESS reality 管理）----------
CONFIG_PACKAGE_xray-core=y
CONFIG_PACKAGE_luci-app-ssr-plus=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-i18n-ssr-plus-zh-cn=y

# ---------- USB / 杂项 ----------
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-ledtrig-usbport=y
CONFIG_PACKAGE_uboot-envtools=y
