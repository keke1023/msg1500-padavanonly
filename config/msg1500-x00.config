#
# RAISECOM MSG1500 X.00 种子配置
# 底座：padavanonly/immortalwrt @ master（ramips/mt7621，immortalwrt 18.06 基线）
# 说明：
#   * make defconfig 会自动补全依赖；被删掉的 rust 包符号会被自动丢弃
#   * MSG1500 设备默认 DEVICE_PACKAGES 用的是开源 kmod-mt7615e，
#     由 build.yml 的 20-patch-wireless.sh 把其改成闭源 kmod-mt7615d + luci-app-mtwifi（K2P 风格）
#   * 本 seed 不再勾 luci-ssl，使用纯 HTTP 的 LuCI（避免 libustream 后端冲突）
#

# ---------- 目标设备 ----------
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_DEVICE_ramips_mt7621_DEVICE_raisecom_msg1500-x-00=y
# 旧式符号兜底（defconfig 会保留有效的一个）
CONFIG_TARGET_ramips_mt7621_DEVICE_raisecom_msg1500-x-00=y

# ---------- 构建选项 ----------
CONFIG_DEVEL=y
CONFIG_CCACHE=y

# ---------- LuCI 基础（纯 HTTP，无 ssl）----------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# ---------- 闭源 MT7615 驱动（K2P 风格，由 wireless patch 注入 DEVICE_PACKAGES）----------
# padavanonly 主线里闭源驱动即 kmod-mt7615d（包名带 kmod- 前缀），编译出内核模块 mt_wifi.ko
# luci-app-mtwifi 的 LUCI_DEPENDS:=+mt_wifi 会自动拉入 userspace 的 mt_wifi 包
#   （Network → Wireless，提供 /lib/wifi/mt7615.lua，使 LuCI 出现 mt_wifi 类型）——
#   这正是 K2P 的写法；此处显式再 pin 一次，配置自解释、防依赖链变动。
CONFIG_PACKAGE_kmod-mt7615d=y
CONFIG_PACKAGE_luci-app-mtwifi=y
CONFIG_PACKAGE_mt_wifi=y

# ---------- 内网穿透（需求项，来自 helloworld master + luci feed）----------
CONFIG_PACKAGE_luci-app-ngrokc=y
CONFIG_PACKAGE_ngrokc=y
CONFIG_PACKAGE_luci-i18n-ngrokc-zh-cn=y
CONFIG_PACKAGE_luci-app-frpc=y
CONFIG_PACKAGE_frpc=y
CONFIG_PACKAGE_luci-i18n-frpc-zh-cn=y
CONFIG_PACKAGE_luci-app-autoreboot=y

# ---------- xray-core + ssr-plus（追加：xray 二进制 + Web UI 管理 VLESS reality）----------
# 重要：helloworld master 默认 xray-core=26.5.9，其 go.mod 要求 go 1.26，
#        本工程 golang 已升到 1.21.13，GOTOOLCHAIN=local 下编不过。
#        由 scripts/37-pin-xray.sh 在 feeds install 后把 xray-core 钉到 24.12.31
#        （go.mod 要求 go 1.21.4，可被 1.21.13 编译，且支持 VLESS reality），
#        并把 PKG_HASH 设为 skip 绕过校验（无法预知上游 tarball 的 sha256）。
CONFIG_PACKAGE_xray-core=y
CONFIG_PACKAGE_luci-app-ssr-plus=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-i18n-ssr-plus-zh-cn=y

# ---------- USB / 杂项（来自 DEVICE_PACKAGES，显式保留）----------
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-ledtrig-usbport=y
CONFIG_PACKAGE_uboot-envtools=y
